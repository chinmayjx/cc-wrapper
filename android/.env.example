# Per-user build settings for cc-wrapper. Copy this file to android/.env (gitignored) and fill in what you use.
# Each key can also come from an environment variable of the same name (e.g. a CI secret); .env wins.
# Every key is optional: an empty value turns its feature off, and the app builds without a .env at all.

# --- Push notifications (Firebase Cloud Messaging) ------------------------------------------------------------
# Firebase console -> your project -> Project settings (gear icon):
#   General tab, "Your project" card: "Project ID"
FIREBASE_PROJECT_ID=
#   Cloud Messaging tab: "Sender ID" (the same number as "Project number" on the General tab)
FIREBASE_SENDER_ID=
#   General tab, "Your apps" card, the Android app you added for io.github.ccwrapper: "App ID" (1:<number>:android:<hex>)
#   (also "mobilesdk_app_id" in that app's google-services.json)
FIREBASE_APP_ID=
#   General tab, "Your project" card: "Web API key" (also "current_key" in google-services.json)
FIREBASE_API_KEY=

# --- Your server (hub) -----------------------------------------------------------------------------------------
# Base URL of your own server, e.g. https://myhost.example:8446 (no trailing slash needed). The app POSTs its FCM
# token to <HUB_URL>/api/devices and the session you just sent a message in to <HUB_URL>/api/activity, and with
# Kindle dictation on (settings tray) keeps a WebSocket open to <HUB_URL>/api/mic (see the README).
# Empty: no registration (the token is only written to logcat, tag CCMPush) and no Kindle dictation.
# PUSH_SERVER_URL, this key's old name, is still read when HUB_URL is empty.
HUB_URL=

# --- Development ----------------------------------------------------------------------------------------------
# Debug build only: a URL serving inject.js and inject.css (e.g. app/src/main/assets/inject/ from a static
# server reachable from the phone). The app re-fetches them each time it comes to the front.
INJECT_DEV_URL=

# --- Release signing ------------------------------------------------------------------------------------------
# Without these, assembleRelease signs with the debug key.
CCM_KEYSTORE=
CCM_KEYSTORE_PASSWORD=
# Defaults to cc-mobile
CCM_KEY_ALIAS=
