# Settings for the Kindle panel. Copy to kindle/.env (never committed) and fill in. The environment overrides
# these; KINDLE_ENV_FILE points elsewhere. Lines left out take the default shown.

# Where it listens. The panel's port is the one you publish (e.g. through a Cloudflare Tunnel); the mic's
# port must stay on your private network: route <HUB_URL>/api/mic to it (see the README).
KINDLE_LISTEN=127.0.0.1:8790
KINDLE_MIC_LISTEN=127.0.0.1:8792
# The panel's public address: POSTs from any other origin are refused.
KINDLE_ORIGIN=https://kindle.example.com

# Who gets in. access (default): Cloudflare Access signs every request and only KINDLE_ACCESS_EMAIL gets in;
# without the three values below every request is refused. none: no check, only for a panel nothing public reaches.
KINDLE_AUTH=access
# Zero Trust > Settings > Custom pages: your team domain; the Access application's Overview: its audience (AUD) tag.
KINDLE_ACCESS_TEAM=https://<your-team>.cloudflareaccess.com
KINDLE_ACCESS_AUD=
KINDLE_ACCESS_EMAIL=you@example.com

# Optional: a server that starts Claude Code Remote Control chats here and brings stopped ones back
# (GET/POST /api/sessions..., see ink/claude.py). Without it there's no "New chat".
#KINDLE_SESSIONS_URL=http://127.0.0.1:8780
# Folders always offered for a new chat (colon-separated).
#KINDLE_FOLDERS=~/code
# Chats always in the list however old: a file of "session_... name" lines.
#KINDLE_PINNED_FILE=~/.config/kindle/pinned-chats

# Optional: an artifact hub (github.com/chinmayjx/artifact-hub). Its API, and the public address of its links,
# which open in the panel's own reader.
#KINDLE_ARTIFACT_HUB_URL=https://artifact-hub.internal:8444
#KINDLE_ARTIFACT_LINK=https://artifacts.example.com

# Dictation: elevenlabs (default), deepgram or whisper. The engine file, if set, is read for every piece and wins.
KINDLE_STT_ENGINE=elevenlabs
#KINDLE_STT_ENGINE_FILE=~/.config/kindle/stt
# Key files hold ELEVENLABS_API_KEY=... / DEEPGRAM_API_KEY=... lines (or set those in the environment).
#KINDLE_ELEVENLABS_KEY_FILE=~/.secrets/elevenlabs/api.env
#KINDLE_DEEPGRAM_KEY_FILE=~/.secrets/deepgram/api.env
# stt/stt_server.py on a machine with a GPU (deploy/stt-server.sh).
#KINDLE_WHISPER_URL=http://<gpu machine>:8793

# Claude Code's sign-in, as the CLI keeps it.
#CLAUDE_CONFIG_DIR=~/.claude
#KINDLE_CLAUDE_JSON=~/.claude.json

# Caches (chats, PDF pages, diagrams, the last dictation) and mermaid-cli (deploy/install.sh --mermaid).
#KINDLE_CACHE_DIR=~/.cache/kindle
#KINDLE_MERMAID_DIR=~/.local/share/kindle/mermaid
